{
  "name": "sqltools-driver-redshift",
  "displayName": "SQLTools Redshift Driver",
  "description": "Amazon Redshift driver for SQLTools with IAM authentication",
  "version": "0.5.6-SNAPSHOT",
  "engines": {
    "vscode": "^1.78.0",
    "node": ">=14.0.0"
  },
  "publisher": "your-publisher-name",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mtxr/vscode-sqltools.git",
    "directory": "packages/driver.redshift"
  },
  "bugs": {
    "url": "https://github.com/mtxr/vscode-sqltools/labels/redshift"
  },
  "keywords": [
    "sqltools-driver",
    "redshift",
    "amazon-redshift",
    "aws",
    "iam"
  ],
  "galleryBanner": {
    "theme": "dark",
    "color": "#333333"
  },
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Other"
  ],
  "extensionDependencies": [
    "mtxr.sqltools"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "sqltools": {
      "drivers": [
        {
          "name": "Redshift",
          "description": "Amazon Redshift driver with IAM authentication",
          "connection": {
            "languageServer": {
              "path": "out/ls/plugin.js"
            },
            "fields": [
              {
                "name": "name",
                "label": "Connection Name",
                "type": "string",
                "required": true
              },
              {
                "name": "roleArn",
                "label": "IAM Role ARN (optional, can be provided via dialog)",
                "type": "string",
                "required": false,
                "placeholder": "arn:aws:iam::123456789012:role/RedshiftRole"
              },
              {
                "name": "clusterIdentifier",
                "label": "Cluster Identifier",
                "type": "string",
                "required": true,
                "placeholder": "my-redshift-cluster"
              },
              {
                "name": "database",
                "label": "Database Name",
                "type": "string",
                "required": true,
                "placeholder": "dev"
              },
              {
                "name": "region",
                "label": "AWS Region",
                "type": "string",
                "required": true,
                "placeholder": "us-east-1"
              },
              {
                "name": "dbUser",
                "label": "Database User",
                "type": "string",
                "required": true,
                "placeholder": "redshift_user"
              },
              {
                "name": "dbGroup",
                "label": "Database Group (optional)",
                "type": "string",
                "required": false,
                "placeholder": "my-db-group"
              },
              {
                "name": "durationSeconds",
                "label": "Credentials Duration (seconds, optional)",
                "type": "number",
                "required": false,
                "default": 3600,
                "placeholder": "3600"
              }
            ]
          }
        }
      ]
    }
  },
  "scripts": {
    "test:tsc": "tsc --noEmit -p ./tsconfig.json --skipLibCheck",
    "clean": "rimraf -rf out dist *.vsix",
    "predev": "yarn run clean",
    "dev": "yarn run watch",
    "prebuild": "yarn run clean",
    "build": "yarn run tsc-check && yarn run compile:ext && yarn run compile:ls",
    "build:no-tsc": "yarn run compile:ext && yarn run compile:ls",
    "compile:ext": "yarn run esbuild --bundle ./src/extension.ts --outfile=./out/extension.js --external:vscode --target=es2017 --define:process.env.PRODUCT=\"'ext'\"",
    "compile:ls": "yarn run esbuild --bundle ./src/ls/plugin.ts --outfile=./out/ls/plugin.js --external:vscode --target=es2015 --define:process.env.PRODUCT=\"'ls'\"",
    "build:ext": "yarn run compile:ext --define:process.env.NODE_ENV=\"'production'\" --minify",
    "build:ls": "yarn run compile:ls --define:process.env.NODE_ENV=\"'production'\" --minify",
    "esbuild": "esbuild --platform=node --tsconfig=./tsconfig.json --external:vscode --external:pg-native --color=true --format=cjs",
    "prepackage": "yarn run build",
    "package": "vsce package --yarn -o .",
    "tsc-check": "yarn run ts --noEmit --preserveWatchOutput",
    "watch": "concurrently \"npm:watch:*\"",
    "watch:ext": "yarn run compile:ext --define:process.env.NODE_ENV=\"'development'\" --sourcemap --watch",
    "watch:ls": "yarn run compile:ls --define:process.env.NODE_ENV=\"'development'\" --sourcemap --watch",
    "dev:tsc": "yarn run tsc-check -w",
    "ts": "tsc -p .",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aws-sdk/client-redshift": "^3.556.0",
    "@aws-sdk/client-sts": "^3.556.0",
    "@sqltools/base-driver": "file:../base-driver",
    "@sqltools/log": "file:../log",
    "@sqltools/types": "file:../types",
    "lodash": "^4.17.19",
    "pg": "^8.2.1"
  },
  "devDependencies": {
    "@sqltools/base-driver": "latest",
    "@sqltools/types": "^0.1.6",
    "@types/lodash": "^4.14.123",
    "@types/node": "^22.14.0",
    "@types/pg": "^7.14.3",
    "@types/vscode": "^1.78.0",
    "@vscode/vsce": "^3.1.1",
    "concurrently": "^5.2.0",
    "esbuild": "^0.25.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "rimraf": "^3.0.2",
    "typescript": "~4.8.3"
  }
}
